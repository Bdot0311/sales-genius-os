{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "OutReign Developers",
  "description": "Developer guides, API reference, MCP and webhooks for OutReign.",
  "colors": {
    "primary": "#7236E2",
    "light": "#8B5AE7",
    "dark": "#7236E2"
  },
  "logo": {
    "light": "/public/apple-touch-icon.png",
    "dark": "/public/apple-touch-icon.png",
    "href": "https://outreign.io"
  },
  "favicon": {
    "light": "/public/apple-touch-icon.png",
    "dark": "/public/apple-touch-icon.png"
  },
  "appearance": {
    "default": "dark"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/developer-docs/introduction",
      "permanent": false
    },
    {
      "source": "/introduction",
      "destination": "/developer-docs/introduction",
      "permanent": false
    },
    {
      "source": "/api-reference/activities/get-a-activity",
      "destination": "/api-reference/activities/get-an-activity"
    }
  ],
  "api": {
    "params": {
      "expanded": "closed"
    },
    "optional": "collapsed",
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://outreign.io/help"
      },
      {
        "label": "API status",
        "href": "https://outreign.io/api-status"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open OutReign",
      "href": "https://outreign.io/dashboard"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "developer-docs/introduction",
              "developer-docs/quickstart",
              "developer-docs/authentication",
              "developer-docs/concepts",
              "developer-docs/capabilities"
            ]
          },
          {
            "group": "Build with OutReign",
            "pages": [
              "developer-docs/pagination",
              "developer-docs/errors-and-limits",
              "developer-docs/integrations",
              "developer-docs/prospecting",
              "developer-docs/email-verification",
              "developer-docs/intelligence",
              "developer-docs/clients",
              "developer-docs/production",
              "developer-docs/workspace-actions",
              "developer-docs/troubleshooting"
            ]
          },
          {
            "group": "Recipes",
            "pages": [
              "developer-docs/guides/prospect-verify-save",
              "developer-docs/guides/import-enrich-draft",
              "developer-docs/guides/sync-crm"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "developer-docs/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "developer-docs/api-overview"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "public/openapi.json"
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "AI assistant connections",
            "pages": [
              "developer-docs/mcp/overview",
              "developer-docs/mcp/connect",
              "developer-docs/mcp/agent-quickstart",
              "developer-docs/mcp/tools"
            ]
          }
        ]
      },
      {
        "tab": "Webhooks",
        "groups": [
          {
            "group": "Event delivery",
            "pages": [
              "developer-docs/webhooks/overview",
              "developer-docs/webhooks/events",
              "developer-docs/webhooks/security-and-retries",
              "developer-docs/webhooks/delivery-operations",
              "developer-docs/webhooks/inbound"
            ]
          }
        ]
      }
    ]
  }
}
