{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ghgfjnepvxvxrncmskys.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "outreign-mcp",
      "version": "0.2.0",
      "title": "OutReign"
    },
    "tools": [
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List the signed-in user's saved leads in OutReign, most recently created first. Optionally filter by lead_status (e.g. new, contacted, qualified) and cap the result count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max number of leads to return (default 25, max 100)."
            },
            "status": {
              "type": "string",
              "description": "Optional lead_status filter, e.g. 'new', 'contacted', 'qualified'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_leads",
        "title": "Search leads",
        "description": "Full-text search across the signed-in user's OutReign leads by contact name, company, email, or job title.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search text to match against name, company, email, or title."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20, max 50)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_sequences",
        "title": "List email sequences",
        "description": "List the signed-in user's outbound email sequences with enrollment and completion totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max results (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_replies",
        "title": "List recent replies",
        "description": "List the most recent inbound replies (inbox threads) captured for the signed-in user, including sender, subject, and classification.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            },
            "unread_only": {
              "type": "boolean",
              "description": "Only return threads that have not been marked read."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_sent_emails",
        "title": "List recent sent emails",
        "description": "List the signed-in user's recently sent outbound emails with subject, recipient, status, and open/reply timestamps.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_deals",
        "title": "List pipeline deals",
        "description": "List the signed-in user's pipeline deals, optionally filtered by stage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "stage": {
              "type": "string",
              "description": "Pipeline stage to filter by."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_icp_profiles",
        "title": "List ICP profiles",
        "description": "List the signed-in user's Ideal Customer Profile definitions with their targeting fields.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_agent_stats",
        "title": "Get AI agent stats",
        "description": "Return every AI SDR agent build the signed-in user owns (name, role, enabled state, persona/tone, limits) plus recent activity: counts of agent actions in the last N days broken down by action_type, status and agent.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "description": "Look-back window in days (default 7)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_lead",
        "title": "Create lead",
        "description": "Create a new lead in OutReign for the signed-in user. At minimum a company_name is required; contact_email is strongly recommended so the lead is reachable by sequences.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_name": {
              "type": "string",
              "minLength": 1
            },
            "contact_name": {
              "type": "string"
            },
            "contact_email": {
              "type": "string",
              "format": "email"
            },
            "job_title": {
              "type": "string"
            },
            "company_website": {
              "type": "string"
            },
            "industry": {
              "type": "string"
            },
            "linkedin_url": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "pipeline_stage": {
              "type": "string",
              "enum": [
                "new",
                "contacted",
                "no_response",
                "replied",
                "bounced",
                "meeting_booked",
                "qualified",
                "not_interested",
                "won",
                "lost"
              ]
            },
            "source": {
              "type": "string",
              "description": "Where the lead came from, e.g. 'mcp'"
            }
          },
          "required": [
            "company_name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_lead",
        "title": "Update lead",
        "description": "Update fields on an existing lead owned by the signed-in user. Pass the lead id and any subset of fields to change. Fields that are omitted are left unchanged.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "company_name": {
              "type": "string"
            },
            "contact_name": {
              "type": "string"
            },
            "contact_email": {
              "type": "string",
              "format": "email"
            },
            "job_title": {
              "type": "string"
            },
            "company_website": {
              "type": "string"
            },
            "industry": {
              "type": "string"
            },
            "linkedin_url": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "pipeline_stage": {
              "type": "string",
              "enum": [
                "new",
                "contacted",
                "no_response",
                "replied",
                "bounced",
                "meeting_booked",
                "qualified",
                "not_interested",
                "won",
                "lost"
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "enroll_lead_in_sequence",
        "title": "Enroll lead in sequence",
        "description": "Enroll one of the signed-in user's leads into one of their email sequences. Creates a sequence_enrollment row with current_step=0 so the outreach worker will send step 1 next.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "format": "uuid"
            },
            "sequence_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "lead_id",
            "sequence_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_reply",
        "title": "Queue reply to an inbox thread",
        "description": "Queue an outbound reply to an existing inbox reply thread. Creates a sent_emails row in status='queued' linked to the original thread's lead so the outreach worker delivers it through the user's connected mailbox. Body is plain text; a simple HTML version is generated automatically.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "reply_thread_id": {
              "type": "string",
              "format": "uuid",
              "description": "id from reply_threads that this message is a reply to."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "description": "Plain text body of the reply."
            },
            "subject": {
              "type": "string",
              "description": "Override subject. Defaults to 'Re: <original subject>'."
            }
          },
          "required": [
            "reply_thread_id",
            "body"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_deal",
        "title": "Update deal",
        "description": "Update fields on an existing pipeline deal owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "company_name": {
              "type": "string"
            },
            "contact_name": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "stage": {
              "type": "string"
            },
            "probability": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "expected_close_date": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_icp_profile",
        "title": "Update ICP profile",
        "description": "Update fields on an existing Ideal Customer Profile owned by the signed-in user. Array fields (industries, target_titles, tech_stack, etc.) replace the previous value entirely when provided.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
