      {
        "name": "update_agent_config",
        "title": "Update AI agent config",
        "description": "Update the signed-in user's AI SDR agent configuration — toggle enabled, change persona/tone/signature, adjust reply capabilities and daily limits. Creates the row if it does not yet exist.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid",
              "description": "Which agent build to update. Defaults to the primary agent."
            },
            "agent_name_match": {
              "type": "string",
              "description": "Alternative to agent_id: match an agent by name."
            },
            "enabled": {
              "type": "boolean"
            },
            "agent_name": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "full_cycle",
                "lead_gen",
                "outreach",
                "replies"
              ]
            },
            "persona": {
              "type": "string"
            },
            "tone": {
              "type": "string"
            },
            "company_context": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            },
            "calendly_url": {
              "type": "string"
            },
            "can_reply_interested": {
              "type": "boolean"
            },
            "can_handle_objections": {
              "type": "boolean"
            },
            "can_book_meetings": {
              "type": "boolean"
            },
            "max_daily_auto_replies": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "reply_delay_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
