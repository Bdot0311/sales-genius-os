# Google Analytics 4 — injected automatically when the GA connector is linked.
VITE_LOVABLE_CONNECTOR_GOOGLE_ANALYTICS_API_KEY=G-XXXXXXXXXX

VITE_POSTHOG_KEY=your_posthog_public_project_token
VITE_POSTHOG_HOST=https://your-posthog-host.example.com

# Supabase (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Cloudflare Turnstile (Recommended for signup protection)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Stripe (Required for payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# AI (Critical - at least one required)
LOVABLE_API_KEY=lovable_gateway_key
AWS_BEARER_TOKEN_BEDROCK=bedrock_token

# Email (Critical)
GOOGLE_CLIENT_ID=google_oauth_client_id
GOOGLE_CLIENT_SECRET=google_oauth_secret

# Lead Data (Recommended)
RAILWAY_LEADS_API_URL=railway_api_url
RAILWAY_API_KEY=railway_api_key
PARALLEL_API_KEY=parallel_api_key
BLOOMBERRY_API_KEY=bloomberry_key
PREDICTLEADS_API_KEY=predictleads_key
PREDICTLEADS_API_TOKEN=predictleads_token

# Email Verification (Recommended)
EMAIL_VERIFIER_API_KEY=verifier_key
EMAIL_VERIFIER_PROVIDER=reoon
COLDIQ_API_KEY=coldiq_key

# Internal (Required for cron jobs)
INTERNAL_TRIGGER_SECRET=your_internal_secret
TURNSTILE_SECRET_KEY=turnstile_secret_key

# Agent Job Configuration (Optional)
AGENT_JOB_CONCURRENCY=4
